# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neovationlabs?retryWrites=true&w=majority
MONGODB_URI=

# --- Client ---
# Used for CORS — the origin your frontend is served from
CLIENT_URL=http://localhost:5173

# --- Email notifications (contact form) ---
# Leave blank to disable email sending; submissions are still saved to MongoDB.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional — defaults to SMTP_USER if not set
CONTACT_NOTIFY_EMAIL=neovationlabs@outlook.com
