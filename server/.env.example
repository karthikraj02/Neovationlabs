# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neovationlabs?retryWrites=true&w=majority
MONGODB_URI=

# --- Client ---
# Used for CORS — the origin your frontend is served from
CLIENT_URL=http://localhost:5173

# --- Email notifications (contact form and demo bookings) ---
# Leave SMTP_* blank to disable email sending; submissions are still saved to MongoDB.
# Every request is always emailed to neovationlabs@outlook.com and
# neovationlabs.official@gmail.com (built in). Anything you list below is ADDED
# to those two, comma-separated. It never replaces them.
#
# Example — sending through a Gmail account (needs an "App password", with 2-step
# verification switched on):   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Example — sending through Outlook.com:   SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional extra recipients, comma-separated
CONTACT_NOTIFY_EMAIL=

# --- WhatsApp alerts (contact form) ---
# Every new project request is also sent to the company WhatsApp number, by the
# server, with nobody having to tap anything. Leave all of these blank to switch it
# off (email and the admin page keep working). Pick ONE of the two ways to send:
#
# A) CallMeBot: free and quick to set up, meant for messaging your OWN number.
#    Follow the one-time activation steps at https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    (you send it one WhatsApp message and it replies with your API key). Unofficial
#    third-party service: your leads pass through it, and delivery is not guaranteed.
CALLMEBOT_API_KEY=
#
# B) Meta WhatsApp Cloud API: the official route. Needs a Meta Business account
#    with a WhatsApp number added to the Cloud API. Alerts arrive at any hour, so
#    also create a message template whose body is:  New project request: {{1}}
#    and put its name below. Without a template, Meta only delivers plain text
#    inside a 24-hour reply window, which alerts usually fall outside of.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
#
# The number that receives the alerts, digits with country code. Defaults to the
# company number, so you normally leave this out.
WHATSAPP_TO=919901723492

# --- Admin dashboard ---
# Long random string that signs admin sessions. Admin login is disabled while
# this is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long an admin stays signed in
ADMIN_TOKEN_TTL=12h
# Timezone used to group visitor analytics by day
ANALYTICS_TIMEZONE=Asia/Kolkata
